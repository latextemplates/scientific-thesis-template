{
  "plugins": {
    "latex2e": true
  },
  "filters": {
    "allowlist": {
      "allow": [
        "/\\bonly\\b/i",
        "/\\bFinally,/",
        "/\\\\[A-Za-z@]+_[A-Za-z@_]+:[A-Za-z]*/",
        "/#[A-Za-z]+:[A-Za-z0-9_-]+/",
        "/\\{markdown\\} package/"
      ]
    }
  },
  "rules": {
    "terminology": true,
    "write-good": {
      "tooWordy": false,
      "whitelist": [
        "only"
      ]
    }
  }
}
